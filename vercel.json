{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(android|iphone|ipod|mobile).*"
        }
      ],
      "destination": "/mobile/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(android|iphone|ipod|mobile).*"
        }
      ],
      "destination": "/mobile/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/mobile/index.html"
    },
    {
      "source": "/mobile/(.*)",
      "destination": "/mobile/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}